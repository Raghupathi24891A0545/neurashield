# ═════════════════════════════════════════════════════════════════════════════
# NeuraShield Cybersecurity Investigation Platform — Configuration
# ═════════════════════════════════════════════════════════════════════════════
# All API keys must remain strictly backend-only. Never expose keys to client code.
# The platform functions with graceful degradation if any or all keys are unset.

# ── AI Reasoning & Orchestration Layer ──────────────────────────────────────
# Google Gemini API key for agentic reasoning and threat synthesis
# Supported models: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_API_KEY=your_gemini_api_key_here

# ── External Security Intelligence Sources ──────────────────────────────────
# VirusTotal API v3 key for URL and domain reputation analysis
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# urlscan.io API key for webpage telemetry, screenshot and DOM analysis
URLSCAN_API_KEY=your_urlscan_api_key_here

# Google Safe Browsing Lookup API (v4) key
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# ── Application Environment ─────────────────────────────────────────────────
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=neurashield_session_secret_key_change_in_production
