{
  "manifest_version": 3,
  "name": "NeuraShield — Cybersecurity SOC Console",
  "version": "1.0.0",
  "description": "Real-time AI Institutional Email Verification, Link Intelligence, and Threat Investigation Console for Gmail and Web Security.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NeuraShield Security Console",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://mail.google.com/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mail.google.com/*"
      ],
      "js": [
        "api/api.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "content/content.css"
      ],
      "matches": [
        "*://mail.google.com/*"
      ]
    }
  ]
}
